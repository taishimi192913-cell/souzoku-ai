# 相続税AI フロントエンド 本番環境変数
# Vercel の Environment Variables で設定

# NextAuth
NEXTAUTH_URL=https://souzoku-ai.com
# NEXTAUTH_SECRET は openssl rand -base64 32 で生成
NEXTAUTH_SECRET=l6CijVZhYDJ51wIFSWz8_lEdv_JujU_DYUo5Rg9Tvrg

# Google OAuth (Google Cloud Console から取得)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend 推奨, https://resend.com)
EMAIL_SERVER=
EMAIL_FROM=noreply@souzoku-ai.com

# データベース
# 本番では PostgreSQL 推奨 (Supabase / Neon)
# DATABASE_URL=postgresql://...

# バックエンドAPI (Next.js のサーバーサイドからの接続先)
NEXT_PRIVATE_API_URL=https://api.souzoku-ai.com
