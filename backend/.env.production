# 相続税AI 本番環境変数
# Docker / Fly.io で上書きする
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CHROMA_PERSIST_DIR=./data/chroma
EMBED_MODEL=BAAI/bge-m3
CHUNK_SIZE=600
CHUNK_OVERLAP=150
TOP_K=5

# セキュリティ
# 本番のフロントエンドURLをカンマ区切りで指定
ALLOWED_ORIGINS=https://souzoku-ai.com,https://souzoku-ai.vercel.app
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# 路線価API（任意）
LAND_PRICE_API_KEY=
